public static void insertionSortPart2(int n, int[] ar) {
    for (int i = 1; i < n; i++) {
        int value = ar[i];
        int j = i - 1;
        while (j >= 0 && ar[j] > value) {
            ar[j + 1] = ar[j];
            j--;
        }
        ar[j + 1] = value;
        printArray(ar);
    }
}
