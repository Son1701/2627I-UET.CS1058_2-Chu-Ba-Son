import java.util.List;
import java.util.ArrayList;

public static List<Integer> countingSort(List<Integer> arr) {
    int[] count = new int[100];
    for (int num : arr) {
        count[num]++;
    }
    List<Integer> result = new ArrayList<>();
    for (int i = 0; i < 100; i++) {
        result.add(count[i]);
    }
    
    return result;
}
